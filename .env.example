# Configuration for MLops Project
# Copy this file to .env and fill in the values for your local setup.
# Never commit .env to Git.

# Dataset settings
DATA_PATH=data/hotel_bookings.csv
TARGET_COLUMN=is_canceled
PROBLEM_TYPE=classification   # classification | regression
TEST_SIZE=0.25
RANDOM_SEED=42
MAX_ITER=1000

# PostgreSQL (for MLflow metadata)
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://mlflow:5000

# Silo (S3-compatible object store)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MLFLOW_S3_ENDPOINT_URL=http://silo:9000
REGION=us-east-1
BUCKET_NAME=mlops-bucket
